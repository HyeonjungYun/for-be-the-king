# For be the King — .gitignore
#
# 원칙: 소스 · 에셋 · 의존성 · 문서는 추적한다. 빌드 산출물과 IDE 캐시는 제외한다.
# 13.5 GB 중 약 285 MB만 추적된다 (Content 130 + Libraries 153 + 소스·문서 ~10).

# ── Unreal Engine ──────────────────────────────────────
S1/Binaries/
S1/Intermediate/
S1/Saved/
S1/DerivedDataCache/
S1/Build/
S1/Backup/

# protoc 생성 헤더 — 원본은 Server/Libraries에 있고 재생성 가능
S1/Source/ProtobufCore/Include/

# ── Visual Studio ──────────────────────────────────────
.vs/
*.sln.docstates
*.VC.db
*.VC.opendb
*.vcxproj.user
*.suo
*.user

# ── C++ 빌드 산출물 ────────────────────────────────────
[Xx]64/
[Xx]86/
[Ww]in32/
*.obj
*.pch
*.ipch
*.ilk
*.pdb
*.idb
*.exe
*.tlog
*.lastbuildstate
*.log

# ── .NET (AuthServer) ──────────────────────────────────
# 경로를 한정한다. 전역 bin/ obj/ 로 두면 [Xx]64/ 때와 같은 사고가 난다
Server/AuthServer/bin/
Server/AuthServer/obj/

# Visual Studio 가 UTF-8 변환 중 만드는 임시 폴더
S1/enc_temp_folder/

# ── 서버 빌드 결과 ─────────────────────────────────────
Server/Binaries/
# ⚠️ Server/Libraries 는 추적한다 (protobuf 21.12 버전 고정 — 2026-08-11 결정)
#    "다른 PC에서 클론했더니 안 빌드됨"이 153 MB보다 비싸다

# ── 프로젝트 규칙 (.claude/docs/directory-structure.md) ──
production/session-state/active.md
production/session-logs/

# 포트폴리오 · 자기소개서 — 별도 제출물. 저장소에 두지 않는다 (2026-09-07)
docs/portfolio/

# ── OS ─────────────────────────────────────────────────
Thumbs.db
Desktop.ini
.DS_Store

# Visual Studio IntelliSense 힌트 — 생성물
cpp.hint

# Python 캐시 — 인터프리터 버전마다 달라져 계속 diff 에 뜬다
__pycache__/
*.pyc

# ServerCore 빌드 출력이 잘못된 경로로 떨어진 것. 정식 위치는 Server/Libraries/Libs/
Server/ServerCore/Libraries/

# 커버리지 리포트 — 매 측정마다 전부 바뀌는 생성물
Server/coverage/
Server/coverage.xml

# 레벨 내보내기 스테이징 — S1LevelBuilder 가 매번 다시 쓰는 생성물 (design/levels/floor-1.md § 9).
# 서버가 벽을 읽게 되면(level-map.md OQ-1) 내보내기 대상을 Server/Data 로 옮기고 이 줄을 지운다.
Server/Data/export/

# 🔴 [Xx]64/ 규칙이 NuGet 패키지의 x64 라이브러리까지 걸러낸다.
#    빌드 산출물을 막으려던 규칙이 의존성을 막았고, CI 에서 gtest_maind.lib 를
#    찾지 못해 링크가 깨졌다. packages 는 예외로 둔다.
!Server/packages/**/x64/
!Server/packages/**/x64/**
# 텔레메트리 · 테스트 출력 (design/gdd/escape-timer.md § G) - 원격 푸시에 들어가면 안 된다
Server/Logs/

# ── Fab 애니메이션 팩 (2026-10-12 런처로 받음, 약 5.7 GB · 6,389 애셋) ──
# 라이선스상 원본을 공개 저장소에 두지 않는다. 프로젝트가 참조하는 클립은 경로만 코드 · CSV 에 남긴다.
# 다시 받으려면 런처 라이브러리 → 프로젝트에 추가 (S1)
S1/Content/Archer/
S1/Content/BCD_Anims/
S1/Content/Dagger/
S1/Content/Fighter_Animations/
S1/Content/Mage/
S1/Content/Spear/
S1/Content/EssentialAnimation/
S1/Content/GhostSamurai_Bundle/

# 서버 검증 툴 보고서 (Tools/verify/verify-server.ps1) - 실행마다 새로 만든다
Tools/verify/reports/
