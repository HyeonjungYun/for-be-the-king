<Window x:Class="ServerMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ServerMonitor"
        Title="ServerMonitor - For be the King 서버 디버깅 툴" Height="900" Width="1600"
        Background="#15191E" Foreground="#E8E8E8" FontFamily="Malgun Gothic" FontSize="12"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#1E242B"/>
        <SolidColorBrush x:Key="Line" Color="#333C46"/>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#262D35"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="BorderBrush" Value="#3A4450"/>
            <Setter Property="Padding" Value="3,2"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2F3A46"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="BorderBrush" Value="#46525F"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="3,0"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ListView">
            <Setter Property="Background" Value="#1A1F25"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="BorderBrush" Value="#333C46"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#9EC5E8"/>
            <Setter Property="BorderBrush" Value="#333C46"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
        <!-- 기본 Aero2 템플릿은 선택 · 머리글을 밝은 색으로 고정해 어두운 글씨 바탕에서 안 보인다 -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="Padding" Value="14,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="#1E242B" BorderBrush="#333C46" BorderThickness="1,1,1,0" Padding="{TemplateBinding Padding}" Margin="0,0,2,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#25303B"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2D5078"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 태그 토글 - 켜짐 = 밝은 바탕, 꺼짐 = 흐리게. 글씨 · 테두리 색은 코드가 태그 색으로 -->
        <Style x:Key="TagToggle" TargetType="ToggleButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="#1A1F25" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}" Opacity="0.4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A3542"/>
                                <Setter TargetName="Bd" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#34414F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <GridViewRowPresenter Columns="{TemplateBinding GridView.ColumnCollection}" Content="{TemplateBinding Content}" Margin="0,1"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#25303B"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2D5078"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Foreground" Value="#CFD8DC"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Grid>
                            <Border Background="#262D35" BorderBrush="#3A4450" BorderThickness="0,0,1,1" Padding="6,3">
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Border>
                            <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right" Width="6" Margin="0,0,-3,0" Cursor="SizeWE">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#15191E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 접속 -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="8,6">
            <DockPanel LastChildFill="False">
                <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="Gray" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="정보 파일" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox x:Name="InfoPathBox" Width="420" VerticalAlignment="Center" ToolTip="서버가 부팅 때 쓰는 Logs\admin.json (포트 · 토큰). FBTK_ADMIN_FILE 로 바꿨으면 그 파일"/>
                <Button Content="…" Click="OnBrowseInfo" ToolTip="admin.json 고르기"/>
                <TextBlock Text="포트" VerticalAlignment="Center" Margin="10,0,4,0"/>
                <TextBox x:Name="PortBox" Width="60" VerticalAlignment="Center" ToolTip="비우면 정보 파일의 포트. 여러 서버가 떠 있으면 직접 (FBTK_ADMIN_PORT)"/>
                <TextBlock Text="토큰" VerticalAlignment="Center" Margin="10,0,4,0"/>
                <PasswordBox x:Name="TokenBox" Width="120" VerticalAlignment="Center" Background="#262D35" Foreground="#E8E8E8" ToolTip="비우면 정보 파일의 토큰"/>
                <Button x:Name="ConnectButton" Content="연결" Click="OnConnect" Margin="10,0,3,0"/>
                <Button Content="지난 로그 열기" Click="OnOpenLog" ToolTip="Logs\events\events-*.jsonl - 서버가 꺼진 뒤에도 같은 화면으로"/>
                <TextBlock x:Name="ServerInfoText" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="#9E9E9E"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- 접속자 -->
            <DockPanel Grid.Column="0" Margin="6">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <TextBlock x:Name="PlayersTitle" Text="접속자" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                    <CheckBox x:Name="HideBotsBox" Content="봇 숨기기" DockPanel.Dock="Right" Click="OnPlayersFilter"/>
                </DockPanel>
                <TextBox x:Name="PlayerSearchBox" DockPanel.Dock="Top" Margin="0,0,0,4" TextChanged="OnPlayersFilter" ToolTip="이름 · id · 방"/>
                <ListView x:Name="PlayersList" SelectionChanged="OnPlayerSelected" SelectionMode="Single">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="이름" Width="96" DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="상태" Width="64" DisplayMemberBinding="{Binding StateText}"/>
                            <GridViewColumn Header="방" Width="40" DisplayMemberBinding="{Binding Room}"/>
                            <GridViewColumn Header="체력" Width="66" DisplayMemberBinding="{Binding HpText}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource Line}"/>

            <TabControl Grid.Column="2" x:Name="Tabs" Background="#15191E" Foreground="#E8E8E8" BorderBrush="{StaticResource Line}" Margin="2,6">
                <!-- 로그 -->
                <TabItem Header="로그">
                    <DockPanel>
                        <WrapPanel x:Name="TagPanel" DockPanel.Dock="Top" Margin="2,4"/>
                        <WrapPanel DockPanel.Dock="Top" Margin="2,2,2,6">
                            <Button Content="태그 전부" Click="OnTagsAll"/>
                            <Button Content="태그 없음" Click="OnTagsNone"/>
                            <TextBlock Text="하위 종류" VerticalAlignment="Center" Margin="10,0,4,0"/>
                            <TextBox x:Name="SubBox" Width="110" TextChanged="OnFilterChanged" ToolTip="예: skill_fire · damage · enter (부분 일치)"/>
                            <TextBlock Text="검색" VerticalAlignment="Center" Margin="10,0,4,0"/>
                            <TextBox x:Name="SearchBox" Width="170" TextChanged="OnFilterChanged" ToolTip="내용 · 방 · 이름 (부분 일치)"/>
                            <CheckBox x:Name="OnlySelectedBox" Content="선택한 플레이어만" Click="OnFilterChanged"/>
                            <RadioButton x:Name="ActorOnlyRadio" Content="행위자만" GroupName="who" Click="OnFilterChanged"/>
                            <RadioButton x:Name="AnyRoleRadio" Content="관련 전부" GroupName="who" IsChecked="True" Click="OnFilterChanged"/>
                            <CheckBox x:Name="ErrorsOnlyBox" Content="오류만" Click="OnFilterChanged"/>
                            <CheckBox x:Name="AutoScrollBox" Content="자동 스크롤" IsChecked="True"/>
                            <Button Content="지우기" Click="OnClearLog" ToolTip="화면의 이벤트만 지운다 (서버 · 파일은 그대로)"/>
                        </WrapPanel>
                        <TextBox x:Name="EventDetailBox" DockPanel.Dock="Bottom" Height="70" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
                        <ListView x:Name="EventsList" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.IsDeferredScrollingEnabled="False" SelectionChanged="OnEventSelected" FontFamily="Malgun Gothic">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                    <Setter Property="Padding" Value="0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                            <Setter Property="Background" Value="#4A1F22"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="시각" Width="88" DisplayMemberBinding="{Binding Time}"/>
                                    <GridViewColumn Header="태그" Width="70">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding TagLabel}" Foreground="{Binding TagBrush}" FontWeight="Bold"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="하위" Width="100" DisplayMemberBinding="{Binding Sub}"/>
                                    <GridViewColumn Header="행위자" Width="110" DisplayMemberBinding="{Binding ActorText}"/>
                                    <GridViewColumn Header="대상" Width="110" DisplayMemberBinding="{Binding TargetText}"/>
                                    <GridViewColumn Header="방" Width="40" DisplayMemberBinding="{Binding Room}"/>
                                    <GridViewColumn Header="내용" Width="700" DisplayMemberBinding="{Binding Msg}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                </TabItem>

                <!-- 맵 -->
                <TabItem Header="맵">
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Top" Margin="2,4">
                            <TextBlock Text="방" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ComboBox x:Name="RoomCombo" Width="330" SelectionChanged="OnRoomSelected"/>
                            <Button Content="맞추기" Click="OnMapFit" ToolTip="층 전체가 보이게"/>
                            <CheckBox x:Name="LayerPlayers" Content="플레이어 · 봇" IsChecked="True" Click="OnLayers"/>
                            <CheckBox x:Name="LayerMonsters" Content="몬스터" IsChecked="True" Click="OnLayers"/>
                            <CheckBox x:Name="LayerBags" Content="가방 · 상자" IsChecked="True" Click="OnLayers"/>
                            <CheckBox x:Name="LayerTraces" Content="전투 흔적" IsChecked="True" Click="OnLayers" ToolTip="장판 · 투사체 · 사망 지점 (10 초)"/>
                            <CheckBox x:Name="LayerRoutes" Content="순찰 길" IsChecked="True" Click="OnLayers"/>
                            <CheckBox x:Name="LayerLabels" Content="이름" IsChecked="True" Click="OnLayers"/>
                            <CheckBox x:Name="LayerVision" Content="시야 원" IsChecked="True" Click="OnLayers" ToolTip="선택한 플레이어의 FoW 시야 반경"/>
                            <CheckBox x:Name="FollowBox" Content="따라가기" Click="OnLayers" ToolTip="선택한 플레이어를 가운데에 (방을 옮기면 같이)"/>
                        </WrapPanel>
                        <TextBlock DockPanel.Dock="Bottom" Margin="4,2" Foreground="#9E9E9E"
                                   Text="● 사람  ■ 봇 (테두리 = 파티)  ▲ 몬스터 (초록 순찰 · 빨강 추격 · 주황 수색 · 노랑 귀환)  ■ 노랑 상자 · 갈색 가방 (흰 테두리 = 열림)  ◯ 타워 (청록 호 = 게이지)  ✕ 사망  · 휠 확대 · 끌어서 이동 · 클릭 선택"/>
                        <local:MapView x:Name="Map"/>
                    </DockPanel>
                </TabItem>

                <!-- 지표 -->
                <TabItem Header="지표">
                    <DockPanel Margin="6">
                        <TextBlock x:Name="MetricsText" DockPanel.Dock="Top" Margin="2,0,0,8" FontFamily="Consolas" TextWrapping="Wrap"/>
                        <UniformGrid Columns="2" Rows="4">
                            <local:Sparkline x:Name="SparkSessions" Title="동접 (세션)" Margin="4"/>
                            <local:Sparkline x:Name="SparkP95" Title="Room 플러시 P95" Unit="ms" Margin="4"/>
                            <local:Sparkline x:Name="SparkP99" Title="Room 플러시 P99" Unit="ms" Margin="4"/>
                            <local:Sparkline x:Name="SparkMax" Title="Room 플러시 max" Unit="ms" Margin="4"/>
                            <local:Sparkline x:Name="SparkMem" Title="커밋 메모리" Unit="MB" Margin="4"/>
                            <local:Sparkline x:Name="SparkSent" Title="송신" Unit="Mbps" Margin="4"/>
                            <local:Sparkline x:Name="SparkRecv" Title="수신" Unit="Mbps" Margin="4"/>
                            <local:Sparkline x:Name="SparkDb" Title="DB 큐 (대기 + 지연)" Margin="4"/>
                        </UniformGrid>
                    </DockPanel>
                </TabItem>
            </TabControl>

            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource Line}"/>

            <!-- 상세 · 관리 -->
            <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto" Margin="6">
                <StackPanel>
                    <GroupBox Header="플레이어 상세">
                        <StackPanel>
                            <TextBlock x:Name="DetailTitle" Text="(접속자 목록 · 맵에서 고르기)" FontSize="14" FontWeight="Bold" Margin="0,0,0,4" Foreground="#E8E8E8"/>
                            <TextBlock x:Name="DetailText" FontFamily="Consolas" TextWrapping="Wrap" Foreground="#E8E8E8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="맵에서 보기" Click="OnShowOnMap"/>
                                <Button Content="이 플레이어 로그" Click="OnShowPlayerLog"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="관리 명령">
                        <StackPanel>
                            <TextBlock Text="강제 종료 - 선택한 플레이어 (사유는 이벤트 로그에 남는다)" Foreground="#BDBDBD" TextWrapping="Wrap"/>
                            <DockPanel Margin="0,3">
                                <Button Content="강제 종료" DockPanel.Dock="Right" Click="OnKick" Background="#5A2A2A"/>
                                <TextBox x:Name="KickReasonBox" Text="관리자 조치"/>
                            </DockPanel>
                            <TextBlock Text="정지 해제 - 선택한 플레이어의 계정, 또는 캐릭터 이름 (strike 도 지운다)" Foreground="#BDBDBD" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            <DockPanel Margin="0,3">
                                <Button Content="정지 해제" DockPanel.Dock="Right" Click="OnUnban"/>
                                <TextBox x:Name="UnbanNameBox" ToolTip="비우면 선택한 플레이어의 계정"/>
                            </DockPanel>
                            <TextBlock Text="전체 공지 - 접속한 모든 사람의 던전 HUD 에 8 초" Foreground="#BDBDBD" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            <TextBox x:Name="NoticeBox" Height="48" TextWrapping="Wrap" AcceptsReturn="False" Margin="0,3"/>
                            <Button Content="공지 보내기" HorizontalAlignment="Right" Click="OnNotice"/>
                            <TextBlock x:Name="AdminResultText" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#FFD54F"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="8,3">
            <TextBlock x:Name="StatusText" Foreground="#BDBDBD" Text="연결 안 됨 - 서버를 띄운 뒤 [연결] 또는 [지난 로그 열기]"/>
        </Border>
    </Grid>
</Window>
